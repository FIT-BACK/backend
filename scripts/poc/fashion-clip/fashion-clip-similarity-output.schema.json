{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIT-BACK Fashion-CLIP PoC A similarity evaluation output",
  "type": "object",
  "required": ["generatedAt", "query", "pairs", "summary"],
  "properties": {
    "generatedAt": {"type": "string", "minLength": 1},
    "query": {
      "type": "object",
      "required": ["imageId", "imagePath"],
      "properties": {
        "imageId": {"type": "string", "minLength": 1},
        "imagePath": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pairs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["queryId", "queryPath", "candidateId", "candidatePath", "relation", "cosineSimilarity"],
        "properties": {
          "queryId": {"type": "string", "minLength": 1},
          "queryPath": {"type": "string", "minLength": 1},
          "candidateId": {"type": "string", "minLength": 1},
          "candidatePath": {"type": "string", "minLength": 1},
          "relation": {
            "type": "string",
            "enum": ["NEAR_DUPLICATE", "VISUALLY_SIMILAR", "SAME_CATEGORY_DIFFERENT_DESIGN", "UNRELATED"]
          },
          "cosineSimilarity": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["NEAR_DUPLICATE", "VISUALLY_SIMILAR", "SAME_CATEGORY_DIFFERENT_DESIGN", "UNRELATED"],
      "propertyNames": {
        "enum": ["NEAR_DUPLICATE", "VISUALLY_SIMILAR", "SAME_CATEGORY_DIFFERENT_DESIGN", "UNRELATED"]
      },
      "additionalProperties": {
        "$ref": "#/$defs/relationSummary"
      }
    }
  },
  "$defs": {
    "relationSummary": {
      "type": "object",
      "required": ["count", "min", "max", "mean", "median"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

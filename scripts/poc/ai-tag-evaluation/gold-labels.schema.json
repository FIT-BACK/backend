{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIT-BACK OpenAI canonical tag gold labels",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["imageId", "imagePath", "expectedCanonicalTags"],
        "properties": {
          "imageId": {"type": "string", "minLength": 1},
          "imagePath": {"type": "string", "minLength": 1},
          "expectedCanonicalTags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "properties": {
                "type": {"type": "string", "enum": ["SILHOUETTE", "COLOR", "DETAIL", "STYLE", "MATERIAL"]},
                "name": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
